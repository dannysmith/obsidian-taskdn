{
  "name": "obsidian-taskdn",
  "version": "0.1.0",
  "type": "module",
  "description": "Render wikilinks to Taskdn task files as interactive checklist widgets",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "check": "tsc --noEmit && eslint src && prettier --check src && vitest run",
    "fix": "eslint src --fix && prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "taskdn"
  ],
  "author": "Danny Smith",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannysmith/obsidian-taskdn.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@lezer/common": "^1.5.0",
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.0.0",
    "obsidian": "^1.7.2",
    "prettier": "^3.7.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.3"
  }
}
