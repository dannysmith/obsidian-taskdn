{
	"name": "obsidian-taskdn",
	"version": "0.2.4",
	"type": "module",
	"description": "Render wikilinks to Taskdn task files as interactive checklist widgets",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check": "tsc --noEmit && eslint . --max-warnings 0 && bun fmt --check src scripts styles.css && bun test",
		"fix": "eslint . --fix && bun fmt src scripts styles.css",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"release": "./scripts/release.sh",
		"test-vault": "bun scripts/test-vault.ts",
		"prepare": "git config core.hooksPath .githooks || true"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tasks",
		"taskdn"
	],
	"author": "Danny Smith",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dannysmith/obsidian-taskdn.git"
	},
	"devDependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@lezer/common": "^1.5.5",
		"@types/bun": "^1.4.4",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "^17.14.0",
		"obsidian": "^1.14.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2"
	}
}
